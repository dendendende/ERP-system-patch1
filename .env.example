# Names only. Never commit real values. Copy to .env.local for development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_DB_URL=
SESSION_TIMEOUT_MINUTES=
# Background jobs (server only)
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Bank source for the sync job: "mock" (development only) or empty to skip.
BANK_ADAPTER=
# Hours without a bank update before the app warns (default 6)
SYNC_STALE_HOURS=
# Who may open the cash forecast (comma list; default owner,viewer)
FORECAST_ROLES=
# Automatic sending to customers is ON HOLD; set to "on" (and re-add the cron) to resume.
REMINDER_AUTO_SEND=
# Reminders: "mock" (development only) or empty to send nothing yet.
REMINDER_CHANNELS=
# Hours reminders may go out, Asia/Jakarta, as start-end (default 08-19)
REMINDER_SEND_HOURS=
# The ONE account customers pay into. Shown in every reminder; changed only here, never by message.
COMPANY_NAME=
COMPANY_BANK_NAME=
COMPANY_ACCOUNT_NUMBER=
COMPANY_ACCOUNT_HOLDER=
# Email sender address; and, in development, the local test inbox (Mailpit, from `supabase start`)
EMAIL_FROM=
MAILPIT_URL=
